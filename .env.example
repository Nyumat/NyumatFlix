TMDB_API_KEY=
ID_MOE_API_KEY=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
DATABASE_URL=
AUTH_RESEND_KEY=
AUTH_SECRET=
CAP_API_ENDPOINT=http://localhost:3030/<site-key>/
CAP_SECRET_KEY=
CAP_SESSION_SECRET=
CAP_ADMIN_KEY=
CAP_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
CAP_PORT=3030
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Override the magic-link From address. Must be on a domain verified in Resend.
# Production default: NyumatFlix <hello@nyumatflix.com>
RESEND_FROM_EMAIL=
FLARESOLVERR_URL=http://localhost:8191/v1
SCRAPE_PROXY_URL=http://127.0.0.1:8888
# Gluetun HTTP proxy (local: scripts/bootstrap-scrape-vpn.sh ensure-local → port 8888).
# Required for vixsrc / vidsrc embed / vidrock when datacenter IPs get 403.
# Set SCRAPE_PREFER_DIRECT=0 to always egress through gluetun when proxy is set.
SCRAPE_PREFER_DIRECT=
LIVE_SCRAPE=
SCRAPE_VPN_CONTROL_URL=
SCRAPE_VPN_CONTROL_API_KEY=
SCRAPE_VPN_ROTATE_SECRET=
SCRAPE_VPN_ROTATE_COUNTRIES=Germany,Netherlands,France,United States
FLIPT_URL=http://127.0.0.1:8090
FLIPT_ENVIRONMENT=default
FLIPT_NAMESPACE=default
FLIPT_API_TOKEN=
FLIPT_FLAG_CACHE_TTL_MS=600000
# Public asset CDN origin (must match next.config assetPrefix / Bunny pull zone)
NEXT_PUBLIC_CDN_ORIGIN=https://cdn.nyumatflix.com
IMGPROXY_PORT=9081
# Call Us Pirates API for the Direct scrape provider (nyumatflix.com only).
# Browser playback talks to CALLUSPIRATES_API_URL directly (CORS + access_token).
# /api/direct/session mints a short-lived token; /api/direct/* remains a fallback proxy.
# Prod: https://calluspirates.com
# Same-docker-host only: http://calluspirates-api:8788 (requires calluspirates-net)
CALLUSPIRATES_API_URL=
# Browser-facing origin if CALLUSPIRATES_API_URL is an internal docker hostname
# CALLUSPIRATES_PUBLIC_URL=https://calluspirates.com
# Must match calluspirates CALLUSPIRATES_INTERNAL_SECRET
CALLUSPIRATES_INTERNAL_SECRET=
# Optional comma-separated extra hosts where Direct is enabled (preview/staging)
# CALLUSPIRATES_DIRECT_ALLOWED_HOSTS=preview.nyumatflix.com
