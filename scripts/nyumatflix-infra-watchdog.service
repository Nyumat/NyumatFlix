[Unit]
Description=Reconcile NyumatFlix scrape/CDN dependencies when unhealthy
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/nyumatflix/infra-watchdog.env
ExecStart=/usr/local/sbin/nyumatflix-infra-watchdog
RuntimeDirectory=nyumatflix-infra-watchdog
RuntimeDirectoryMode=0750
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# NoNewPrivileges must stay off: the reconcile path runs `sudo docker ...`.
# ReadWritePaths is supplied by the per-user drop-in (see
# install-prod-watchdogs.sh) so the reconcile lock/env writes succeed.

[Install]
WantedBy=multi-user.target
