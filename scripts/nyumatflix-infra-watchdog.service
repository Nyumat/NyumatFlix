[Unit]
Description=Reconcile NyumatFlix scrape/CDN dependencies when unhealthy
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/nyumatflix/infra-watchdog.env
ExecStart=/usr/local/sbin/nyumatflix-infra-watchdog
RuntimeDirectory=nyumatflix-infra-watchdog
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
