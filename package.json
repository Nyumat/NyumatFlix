{
  "name": "nyumatflix",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@nyumatflix/web",
    "build": "turbo build",
    "test": "turbo test",
    "test:ci": "turbo test --filter=@nyumatflix/web",
    "typecheck": "turbo typecheck",
    "type-check": "turbo typecheck",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --write",
    "check-format": "turbo check-format --filter=@nyumatflix/web",
    "format": "turbo check-format --filter=@nyumatflix/web -- --write",
    "precommit": "bun run check-format && bun run lint && bun run type-check",
    "prepare": "husky",
    "dev:stack": "./scripts/bootstrap-scrape-vpn.sh local",
    "dev:sync": "./scripts/bootstrap-scrape-vpn.sh sync-env",
    "stack:status": "./scripts/local-compose.sh ps",
    "flaresolverr:up": "./scripts/local-compose.sh up -d flaresolverr",
    "flaresolverr:down": "./scripts/local-compose.sh stop flaresolverr",
    "flaresolverr:logs": "./scripts/local-compose.sh logs -f flaresolverr",
    "flipt:up": "./scripts/local-compose.sh up -d flipt",
    "flipt:down": "./scripts/local-compose.sh stop flipt",
    "flipt:logs": "./scripts/local-compose.sh logs -f flipt",
    "cap:up": "./scripts/local-compose.sh up -d cap cap-valkey",
    "cap:update": "./scripts/local-compose.sh pull cap cap-valkey && ./scripts/local-compose.sh up -d cap cap-valkey",
    "cap:status": "./scripts/local-compose.sh ps cap cap-valkey",
    "cap:down": "./scripts/local-compose.sh stop cap cap-valkey",
    "cap:logs": "./scripts/local-compose.sh logs -f cap",
    "bp": "./scripts/deploy.sh bp",
    "deploy": "bun scripts/nyumatflix.ts",
    "deploy:plain": "./scripts/deploy-remote.sh",
    "deploy:env": "./scripts/sync-prod-env.sh push",
    "rotate": "bun scripts/rotate-vpn.mts"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "husky": "^9.1.6"
  }
}
