#!/bin/sh
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Try to find bun in common locations if not in PATH
if ! command -v bun >/dev/null 2>&1; then
  if [ -f "$HOME/.bun/bin/bun" ]; then
    export PATH="$HOME/.bun/bin:$PATH"
  elif [ -f "/opt/homebrew/bin/bun" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
  elif [ -f "$HOME/.local/bin/bun" ]; then
    export PATH="$HOME/.local/bin:$PATH"
  fi
fi

# Try to find node in common locations if not in PATH (for check-emoji when bun is absent)
if ! command -v node >/dev/null 2>&1; then
  if [ -f "/opt/homebrew/bin/node" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
  elif [ -f "/usr/local/bin/node" ]; then
    export PATH="/usr/local/bin:$PATH"
  fi
fi

run_checker() {
  if command -v bun >/dev/null 2>&1; then
    bun "$SCRIPT_DIR/check-emoji.js" "$1"
    return $?
  fi

  if command -v node >/dev/null 2>&1; then
    node "$SCRIPT_DIR/check-emoji.js" "$1"
    return $?
  fi

  return 2
}

run_emojify() {
  if command -v bun >/dev/null 2>&1; then
    bunx --bun @humankode/git-commit-emojify@latest "$1"
    return $?
  fi

  npx --yes @humankode/git-commit-emojify@latest "$1"
}

run_checker "$1"
status=$?

if [ "$status" -eq 0 ]; then
  exit 0
fi

if [ "$status" -eq 1 ]; then
  run_emojify "$1"
  exit $?
fi

echo "prepare-commit-msg: emoji check failed (exit $status)" >&2
exit "$status"
