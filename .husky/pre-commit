#!/bin/sh
echo "🚀 Running pre-commit checks..."

if ! command -v bun >/dev/null 2>&1; then
  if [ -f "$HOME/.bun/bin/bun" ]; then
    export PATH="$HOME/.bun/bin:$PATH"
  elif [ -f "/opt/homebrew/bin/bun" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
  elif [ -f "$HOME/.local/bin/bun" ]; then
    export PATH="$HOME/.local/bin:$PATH"
  fi
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "❌ Error: bun command not found."
  exit 1
fi

if ! bunx turbo lint test typecheck check-format --filter=@nyumatflix/web...; then
  echo "🚨 Pre-commit checks failed. Please fix the above issues before committing."
  exit 1
fi

echo "✅ All pre-commit checks passed."
